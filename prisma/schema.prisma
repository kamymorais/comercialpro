generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  REGIONAL_MANAGER
  MANAGER
  CONSULTANT
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestedRole {
  REGIONAL_MANAGER
  MANAGER
  CONSULTANT
}

enum ResetStatus {
  SUCCESS
  SKIPPED
  ERROR
}

enum VisitStatus {
  ASSIGNED
  SUBMITTED
  REVISION_REQUESTED
  COMPLETED
}

enum VisitEventType {
  ASSIGNED
  CONSULTANT_SUBMITTED
  REVISION_REQUESTED
  COMPLETED
}

model User {
  id           String @id @default(cuid())
  fullName     String
  username     String @unique
  passwordHash String

  requestedRole RequestedRole?
  role          Role?
  status        UserStatus     @default(PENDING)

  managerId   String?
  manager     User?   @relation("ManagerConsultants", fields: [managerId], references: [id])
  consultants User[]  @relation("ManagerConsultants")

  regionalManagerId String?
  regionalManager   User?   @relation("RegionalManagers", fields: [regionalManagerId], references: [id])
  managers          User[]  @relation("RegionalManagers")

  approvedById  String?
  approvedBy    User?   @relation("ApprovedUsers", fields: [approvedById], references: [id])
  approvedUsers User[]  @relation("ApprovedUsers")

  approvedAt DateTime?
  rejectedAt DateTime?

  sessions                   Session[]
  passwordResetTokens        PasswordResetToken[] @relation("UserPasswordResetTokens")
  createdPasswordResetTokens PasswordResetToken[] @relation("AdminCreatedPasswordResetTokens")
  forecasts                  DailyForecast[]      @relation("ConsultantForecasts")
  updatedForecasts           DailyForecast[]      @relation("ForecastUpdatedBy")
  assignedVisits             VisitAssignment[]    @relation("VisitAssignmentConsultant")
  managedVisits              VisitAssignment[]    @relation("VisitAssignmentManager")
  visitEvents                VisitEvent[]         @relation("VisitEventAuthor")
  uploadedPhotos             VisitPhoto[]         @relation("VisitPhotoUploader")
  pushSubscriptions          PushSubscription[]
  lostOperations             LostOperation[]      @relation("LostOperationAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([role])
  @@index([managerId])
  @@index([regionalManagerId])
}

model DailyForecast {
  id String @id @default(cuid())

  consultantId String
  consultant   User   @relation("ConsultantForecasts", fields: [consultantId], references: [id])

  operationalDate DateTime

  productionValue Decimal @default(0) @db.Decimal(12, 2)
  insuranceValue  Decimal @default(0) @db.Decimal(12, 2)
  tcValue         Decimal @default(0) @db.Decimal(12, 2)

  noForecast  Boolean   @default(false)
  submittedAt DateTime?

  updatedById String?
  updatedBy   User?   @relation("ForecastUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([consultantId, operationalDate])
  @@index([operationalDate])
  @@index([consultantId])
  @@index([updatedById])
}

model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  createdByAdminId String?
  createdByAdmin   User?   @relation("AdminCreatedPasswordResetTokens", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([createdByAdminId])
}

model ResetLog {
  id String @id @default(cuid())

  operationalDate DateTime    @unique
  executedAt      DateTime    @default(now())
  status          ResetStatus
  message         String?

  createdAt DateTime @default(now())
}

model VisitAssignment {
  id String @id @default(cuid())

  consultantId String
  consultant   User   @relation("VisitAssignmentConsultant", fields: [consultantId], references: [id])

  managerId String
  manager   User   @relation("VisitAssignmentManager", fields: [managerId], references: [id])

  agreementCode String
  agreementName String
  unitId        String
  unitName      String
  unitAddress   String
  unitLatitude  Float
  unitLongitude Float

  status      VisitStatus @default(ASSIGNED)
  assignedAt  DateTime    @default(now())
  submittedAt DateTime?
  completedAt DateTime?

  events VisitEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consultantId, status])
  @@index([managerId, status])
  @@index([createdAt])
}

model VisitEvent {
  id String @id @default(cuid())

  visitAssignmentId String
  visitAssignment   VisitAssignment @relation(fields: [visitAssignmentId], references: [id])

  authorId String
  author   User   @relation("VisitEventAuthor", fields: [authorId], references: [id])

  type VisitEventType
  note String?

  photos VisitPhoto[]

  createdAt DateTime @default(now())

  @@index([visitAssignmentId, createdAt])
  @@index([authorId])
}

model VisitPhoto {
  id String @id @default(cuid())

  visitEventId String
  visitEvent   VisitEvent @relation(fields: [visitEventId], references: [id])

  uploadedById String
  uploadedBy   User   @relation("VisitPhotoUploader", fields: [uploadedById], references: [id])

  pathname     String @unique
  blobUrl      String
  originalName String
  contentType  String
  sizeBytes    Int

  createdAt DateTime @default(now())

  @@index([visitEventId])
  @@index([uploadedById])
  @@index([createdAt])
}

// Assinatura Web Push de um dispositivo/navegador do usuario. Um mesmo
// usuario pode ter varias (celular, tablet, computador); o endpoint
// identifica o dispositivo/navegador de forma unica.
model PushSubscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Registro de execucao do lembrete diario de previsao (cron as 09h de
// Brasilia), no mesmo espirito do ResetLog: evita reenviar a notificacao
// caso o cron seja disparado mais de uma vez no mesmo dia.
model PushReminderLog {
  id String @id @default(cuid())

  sentDate       DateTime    @unique
  executedAt     DateTime    @default(now())
  status         ResetStatus
  recipientCount Int         @default(0)
  message        String?

  createdAt DateTime @default(now())
}

// Operacao perdida para banco concorrente, registrada pelo proprio usuario
// (consultor ou gerente) para que sua hierarquia acompanhe. A visibilidade
// segue a mesma regra da previsao: consultor ve so as suas, gerente ve as
// suas e as dos consultores vinculados, regional/admin veem todas.
model LostOperation {
  id String @id @default(cuid())

  authorId String
  author   User   @relation("LostOperationAuthor", fields: [authorId], references: [id])

  clientName     String
  operationValue Decimal? @db.Decimal(12, 2)
  agency         String
  competitorBank String
  rate           Decimal @db.Decimal(7, 4)
  operationType  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, createdAt])
  @@index([createdAt])
}
